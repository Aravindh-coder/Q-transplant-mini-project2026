# Q-Transplant v4 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control!

# ── Database ───────────────────────────────────────────────
# Leave empty for SQLite (default: q_transplant_v4.db)
DATABASE_URL=

# ── JWT Authentication ─────────────────────────────────────
# Change this to a strong random secret in production
JWT_SECRET=change_me_to_a_random_secret_string
ACCESS_TOKEN_MINUTES=720

# ── Root Organizer Account ─────────────────────────────────
ORGANIZER_BOOTSTRAP_EMAIL=root@qtransplant.org
ORGANIZER_BOOTSTRAP_PASSWORD=root123

# ── Email Notifications (optional) ────────────────────────
ORGANIZER_EMAIL=your_email@gmail.com
# Gmail App Password (not your Gmail password!)
ORGANIZER_APP_PASSWORD=

# ── AI Assistant ───────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# ── CORS Origins ───────────────────────────────────────────
ALLOWED_ORIGINS=*
